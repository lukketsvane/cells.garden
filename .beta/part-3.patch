diff --git a/src/core/help.ts b/src/core/help.ts
new file mode 100644
index 0000000..d4de0b1
--- /dev/null
+++ b/src/core/help.ts
@@ -0,0 +1,48 @@
+/** Help and project information shared by every distribution. */
+import { menuRow, type MenuItem } from './menu';
+import { RELEASE_CHANNEL, RELEASE_VERSION } from './release';
+import { Modal } from './ui';
+
+export const ISSUE_URL = 'https://github.com/lukketsvane/cells.garden/issues/new';
+export const ABOUT_URL = 'https://cells.garden/about/';
+export const SUPPORT_URL = 'https://buymeacoffee.com/cells.garden';
+export const SUPPORT_EMAIL = 'cells.garden@proton.me';
+
+export function reportIssueMenu(): MenuItem {
+    return {
+        label: 'Report issue',
+        panel: (panel, menu) => {
+            for (const [label, url] of [
+                ['Create a GitHub issue', ISSUE_URL],
+                [SUPPORT_EMAIL, `mailto:${SUPPORT_EMAIL}`],
+            ]) {
+                menuRow(panel, { label }).onclick = () => {
+                    menu.close();
+                    window.open(url, '_blank', 'noopener,noreferrer');
+                };
+            }
+        },
+    };
+}
+
+export class AboutModal extends Modal {
+    onOpen() {
+        this.modalEl.addClass('share-modal');
+        const el = this.contentEl;
+        el.createEl('h2', { text: 'About cells.garden' });
+        el.createEl('p', { text: `${RELEASE_CHANNEL} ${RELEASE_VERSION}` });
+        el.createEl('p', { text: 'Turn projects and tasks into a pixel-art garden. Work locally, or sign in to sync and share across devices and apps.' });
+        el.createEl('p', { text: 'Free and open source. Support is optional and does not unlock features.' });
+        for (const [label, href] of [
+            ['About the project', ABOUT_URL],
+            ['How to use the garden', 'https://cells.garden/guide/'],
+            ['Support cells.garden', SUPPORT_URL],
+            [SUPPORT_EMAIL, `mailto:${SUPPORT_EMAIL}`],
+        ]) {
+            el.createEl('p').createEl('a', {
+                text: label,
+                attr: { href, target: '_blank', rel: 'noopener noreferrer' },
+            });
+        }
+    }
+}
diff --git a/src/core/release.test.ts b/src/core/release.test.ts
new file mode 100644
index 0000000..5b362f7
--- /dev/null
+++ b/src/core/release.test.ts
@@ -0,0 +1,48 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { RELEASE_CHANNEL, RELEASE_VERSION } from './release';
+
+const read = (path: string) => readFileSync(new URL(`../../${path}`, import.meta.url), 'utf8');
+const json = (path: string) => JSON.parse(read(path)) as Record<string, unknown>;
+
+test('beta 0.2.0 is coordinated across the web, Chrome and Obsidian', () => {
+    assert.equal(RELEASE_CHANNEL, 'beta');
+    assert.equal(RELEASE_VERSION, '0.2.0');
+    for (const path of ['package.json', 'package-lock.json', 'manifest.json', 'obsidian-plugin/manifest.json']) {
+        assert.equal(json(path).version, RELEASE_VERSION, path);
+    }
+    const lock = json('package-lock.json').packages as Record<string, { version: string }>;
+    assert.equal(lock[''].version, RELEASE_VERSION);
+    assert.equal(json('versions.json')[RELEASE_VERSION], json('manifest.json').minAppVersion);
+    assert.equal(json('manifest.json').minAppVersion, '1.8.7');
+    assert.equal(json('manifest.json').fundingUrl, 'https://buymeacoffee.com/cells.garden');
+    assert.equal(json('obsidian-plugin/manifest.json').fundingUrl, 'https://buymeacoffee.com/cells.garden');
+    assert(read('public/about/index.html').includes(`Beta ${RELEASE_VERSION}`));
+    assert(read('ext/WEBSTORE.md').includes(`Current replacement release: \`${RELEASE_VERSION}\``));
+});
+
+test('About has a static canonical route, redirects, support links and a sitemap entry', () => {
+    const html = read('public/about/index.html');
+    assert(html.includes('href="https://cells.garden/about/"'));
+    assert(html.includes('href="https://buymeacoffee.com/cells.garden"'));
+    assert(html.includes('href="mailto:cells.garden@proton.me"'));
+    assert(!/<script\b/i.test(html), 'the About page needs no script or third-party embed');
+    assert(read('public/sitemap.xml').includes('<loc>https://cells.garden/about/</loc>'));
+    const redirects = json('vercel.json').redirects as { source: string; destination: string }[];
+    for (const source of ['/about', '/about/index.html']) {
+        assert(redirects.some(rule => rule.source === source && rule.destination === '/about/'));
+    }
+});
+
+test('the void tile is a native 32-square PNG with an alpha channel and ships in every theme', () => {
+    const png = readFileSync(new URL('../assets/void_tile.png', import.meta.url));
+    assert.equal(png.subarray(0, 8).toString('hex'), '89504e470d0a1a0a');
+    assert.equal(png.readUInt32BE(16), 32);
+    assert.equal(png.readUInt32BE(20), 32);
+    assert([4, 6].includes(png[25]), 'use grayscale+alpha or RGBA, not an opaque image');
+    const css = read('src/core/void-tile.css');
+    assert(css.includes("url('../assets/void_tile.png')"));
+    assert(css.includes('mask-mode: alpha'));
+    assert(css.includes('pointer-events: none'));
+});
