{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Node types stay out of the app's tsconfig on purpose: with them in scope a
    // bare setTimeout returns NodeJS.Timeout, and the garden stores timer ids as
    // numbers. The tests are the only files that may see them.
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*.test.ts"],
  "exclude": []
}
