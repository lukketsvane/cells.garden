{
  "name": "cells.garden",
  "version": "0.1.0",
  "private": true,
  "description": "A kanban-style project garden where tasks grow into plants. Web app, PWA and Chrome extension around one core.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:ext": "vite build --config vite.ext.config.ts",
    "dev:ext": "vite build --config vite.ext.config.ts --watch --mode development",
    "icons": "node scripts/make-icons.mjs",
    "test:web": "node scripts/test-web.mjs",
    "test:ext": "node scripts/test-ext.mjs",
    "typecheck:ext": "tsc --noEmit -p tsconfig.ext.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "js-yaml": "^4.1.0",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/sortablejs": "^1.15.8",
    "playwright": "^1.56.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
