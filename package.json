{
  "name": "cells.garden",
  "version": "0.1.1",
  "private": true,
  "description": "Your tasks grow into a pixel-art garden: a board on every new tab, in the side panel and the toolbar, synced across devices.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web && npm run build:ext && npm run build:obsidian",
    "build:web": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src ext obsidian-plugin/main.ts",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "build:ext": "vite build --config vite.ext.config.ts",
    "dev:ext": "vite build --config vite.ext.config.ts --watch --mode development",
    "icons": "node scripts/make-icons.mjs",
    "test:unit": "node --import ./scripts/ts-resolve.mjs --test \"src/**/*.test.ts\"",
    "test:web": "node scripts/test-web.mjs",
    "test:ext": "node scripts/test-ext.mjs",
    "typecheck:ext": "tsc --noEmit -p tsconfig.ext.json",
    "build:obsidian": "vite build --config vite.obsidian.config.ts",
    "typecheck:obsidian": "tsc --noEmit -p tsconfig.obsidian.json",
    "test:obsidian": "node scripts/test-obsidian.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "sortablejs": "^1.15.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.0",
    "@types/node": "^22.20.3",
    "@types/sortablejs": "^1.15.8",
    "eslint": "^10.10.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.1",
    "playwright": "^1.56.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
